generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Role {
  ADMIN
  PM
  FOREMAN
}

enum UnitOfMeasure {
  CY // cubic yard
  SF // square foot
  LF // linear foot
  SQ // roofing square
  TON
  EA // each
  HR // hour (labor-only cost codes, e.g. punch list)
  LS // lump sum
}

// Construction-phase stage, distinct from JobStatus (which tracks whether the
// job is scheduled/active/done at all). Drives the Command Center and billing
// readiness — e.g. you can't be billing-ready before CLOSEOUT.
enum ProjectStage {
  PRECON
  MOBILIZATION
  ACTIVE
  PUNCH_LIST
  CLOSEOUT
  COMPLETE
}

enum CostCategory {
  LABOR
  MATERIAL
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
}

enum ChangeOrderStatus {
  IDENTIFIED
  PRICED
  SUBMITTED
  APPROVED
  REJECTED
}

enum MaterialRequestStatus {
  REQUESTED
  APPROVED
  PO_ISSUED
  ORDERED
  RECEIVED
  REJECTED
}

enum EquipmentOwnership {
  OWNED
  RENTED
}

enum SubcontractorCostStatus {
  COMMITTED
  INVOICED
  PAID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

model Worker {
  id                  String                 @id @default(cuid())
  name                String
  role                String?
  phone               String?
  email               String?
  laborRate           Float? // $/hr — used to price actual labor cost from logged production hours
  active              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  jobs                JobAssignment[]
  productionEntries   ProductionEntry[]
  scheduleAssignments ScheduleAssignment[]
  dailyReports        DailyReport[]
  materialRequests    MaterialRequest[]
  changeOrdersCreated ChangeOrder[]
  foremanForJobs      Job[]                  @relation("JobForeman")
  unavailability      WorkerUnavailability[]
  checklistItemsDone  JobChecklistItem[]
  documentsUploaded   Document[]
}

// A day a worker is marked unavailable (PTO, sick, other commitment) — checked
// when assigning the crew schedule so a dispatcher gets a warning instead of
// silently double-booking someone who can't actually show up.
model WorkerUnavailability {
  id        String   @id @default(cuid())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([workerId, date])
}

// Login account. Distinct from Worker (a Worker is a crew member who may or
// may not ever log in — a laborer with no account is still schedulable and
// can still be recorded as who a foreman entered production for).
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(FOREMAN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  pmForJobs    Job[]    @relation("JobPM")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  jobs      Job[]
}

model Job {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      JobStatus @default(SCHEDULED)
  address     String?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    Customer? @relation(fields: [customerId], references: [id])
  customerId  String?

  // Command Center fields
  contractValue        Float?
  pm                   User?        @relation("JobPM", fields: [pmUserId], references: [id])
  pmUserId             String?
  foreman              Worker?      @relation("JobForeman", fields: [foremanWorkerId], references: [id])
  foremanWorkerId      String?
  targetStartDate      DateTime?
  targetEndDate        DateTime?
  stage                ProjectStage @default(PRECON)
  punchListComplete    Boolean      @default(false)
  requiredDocsComplete Boolean      @default(false)

  assignments          JobAssignment[]
  costCodes            JobCostCode[]
  scheduleAssignments  ScheduleAssignment[]
  budgets              JobBudget[]
  changeOrders         ChangeOrder[]
  dailyReports         DailyReport[]
  materialRequests     MaterialRequest[]
  equipmentAssignments EquipmentAssignment[]
  subcontractorCosts   SubcontractorCost[]
  invoices             Invoice[]
  checklistItems       JobChecklistItem[]
  documents            Document[]
}

// A real invoice record — "billed to date" is computed as the sum of SENT
// and PAID invoices rather than a manually-typed running total, so it can't
// drift from what was actually issued.
model Invoice {
  id            String        @id @default(cuid())
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String
  invoiceNumber String
  amount        Float
  date          DateTime
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now())

  @@unique([jobId, invoiceNumber])
}

model JobAssignment {
  id       String @id @default(cuid())
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId    String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId String

  @@unique([jobId, workerId])
}

// Master cost code list — the estimating asset. Historical productivity
// (actual hrs/unit) is derived from ProductionEntry rows across every job
// that has ever used this code, not stored redundantly here.
model CostCode {
  id           String        @id @default(cuid())
  code         String        @unique
  description  String
  unit         UnitOfMeasure
  glCode       String? // maps this cost code to the accounting system's GL/cost code for export
  createdAt    DateTime      @default(now())
  jobCostCodes JobCostCode[]
}

// Maps each cost category to a GL account for the accounting export — a
// company-wide setting (not per-job), configured once by accounting/admin.
model AccountingCategoryMapping {
  id            String       @id @default(cuid())
  category      CostCategory @unique
  glCode        String
  glAccountName String?
  updatedAt     DateTime     @updatedAt
}

// The budget line: what a job's estimate says a cost code should cost in
// quantity and labor hours. This is the "connects to your estimate" piece —
// actuals logged against it are compared back to these numbers in real time.
model JobCostCode {
  id             String            @id @default(cuid())
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  costCode       CostCode          @relation(fields: [costCodeId], references: [id])
  costCodeId     String
  estimatedQty   Float
  estimatedHours Float
  createdAt      DateTime          @default(now())
  entries        ProductionEntry[]

  @@unique([jobId, costCodeId])
}

// A single day's field-reported labor and quantity-installed against a
// job's cost code budget line. This is the daily foreman input that closes
// the field-to-cost feedback loop same-day instead of on a payroll cycle.
model ProductionEntry {
  id            String      @id @default(cuid())
  jobCostCode   JobCostCode @relation(fields: [jobCostCodeId], references: [id], onDelete: Cascade)
  jobCostCodeId String
  date          DateTime
  crewSize      Int?
  hours         Float
  quantity      Float
  notes         String?
  enteredBy     Worker?     @relation(fields: [enteredById], references: [id])
  enteredById   String?
  createdAt     DateTime    @default(now())

  @@index([jobCostCodeId])
}

// One worker's job assignment for one calendar day — the crew scheduling
// board. A worker can only be on one job per day, which is what keeps a
// GC from double-booking a crew across concurrent jobs.
model ScheduleAssignment {
  id        String   @id @default(cuid())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([workerId, date])
  @@index([jobId, date])
}

// The original budget per cost category, set once at job kickoff. Committed
// and actual dollars are computed from the operational tables below (material
// requests, equipment assignments, subcontractor costs, logged labor hours)
// rather than duplicated here, so they can't drift out of sync.
model JobBudget {
  id              String       @id @default(cuid())
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId           String
  category        CostCategory
  estimatedAmount Float
  createdAt       DateTime     @default(now())

  @@unique([jobId, category])
}

// Field-identified extra work, priced and routed through PM approval before
// it becomes contract revenue and budget — the change-order workflow.
model ChangeOrder {
  id                  String            @id @default(cuid())
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId               String
  title               String
  description         String?
  status              ChangeOrderStatus @default(IDENTIFIED)
  revenueAmount       Float? // added to contract value once approved
  costAmount          Float? // added budget impact once approved
  sourceDailyReport   DailyReport?      @relation(fields: [sourceDailyReportId], references: [id])
  sourceDailyReportId String?
  createdBy           Worker?           @relation(fields: [createdById], references: [id])
  createdById         String?
  createdAt           DateTime          @default(now())
  approvedAt          DateTime?
}

// The upgraded field daily report — one per job per day, fast to fill out,
// covering crew/hours, progress, and every exception category (material,
// equipment, safety, change conditions, delays) in one form.
model DailyReport {
  id                   String   @id @default(cuid())
  job                  Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId                String
  date                 DateTime
  crewSize             Int?
  hours                Float?
  quantityInstalled    String? // free-text — e.g. "35 CY slab", not tied to a specific cost code
  workCompleted        String?
  blockers             String?
  materialNeeded       String?
  equipmentIssue       String?
  safetyIssue          String?
  hasChangeCondition   Boolean  @default(false)
  changeConditionNotes String?
  delayReason          String?
  tomorrowPlan         String?
  submittedBy          Worker?  @relation(fields: [submittedById], references: [id])
  submittedById        String?
  createdAt            DateTime @default(now())

  photos       DailyReportPhoto[]
  changeOrders ChangeOrder[]

  @@unique([jobId, date])
  @@index([jobId, date])
}

// Small photo blobs stored in Postgres for MVP simplicity — fine at this
// scale, but a real object store (S3/R2) is the right move before this sees
// heavy photo volume.
model DailyReportPhoto {
  id            String      @id @default(cuid())
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  dailyReportId String
  data          Bytes
  contentType   String
  createdAt     DateTime    @default(now())

  @@index([dailyReportId])
}

// Field request → PM approval → vendor/PO → ordered → received → job cost.
// A request stuck short of RECEIVED past its expected delivery date is what
// the material-risk alert watches for.
model MaterialRequest {
  id                   String                @id @default(cuid())
  job                  Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId                String
  description          String
  quantity             Float
  unit                 String
  status               MaterialRequestStatus @default(REQUESTED)
  vendor               String?
  poNumber             String?
  unitCost             Float?
  totalCost            Float?
  expectedDeliveryDate DateTime?
  receivedDate         DateTime?
  requestedBy          Worker?               @relation(fields: [requestedById], references: [id])
  requestedById        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// Owned or rented equipment, assignable to jobs with a planned date range —
// the source of both scheduling conflicts (same unit, overlapping jobs) and
// actual equipment cost against budget.
model Equipment {
  id              String                @id @default(cuid())
  name            String
  type            String?
  ownership       EquipmentOwnership    @default(OWNED)
  dailyRentalCost Float?
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  assignments     EquipmentAssignment[]
}

model EquipmentAssignment {
  id               String    @id @default(cuid())
  equipment        Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId      String
  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId            String
  startDate        DateTime
  endDate          DateTime
  actualPickupDate DateTime?
  actualReturnDate DateTime?
  downtimeNotes    String?
  createdAt        DateTime  @default(now())

  @@index([equipmentId, startDate, endDate])
  @@index([jobId])
}

// Subcontract cost tracking — committed contract value vs. what's actually
// been invoiced/paid, feeding job costing's subcontractor column.
model SubcontractorCost {
  id              String                  @id @default(cuid())
  job             Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId           String
  vendor          String
  description     String?
  committedAmount Float
  actualAmount    Float                   @default(0)
  status          SubcontractorCostStatus @default(COMMITTED)
  createdAt       DateTime                @default(now())
}

// Company-wide template: what checklist items get auto-generated when a job
// enters a given stage. Editable so the automation stays configurable
// instead of hardcoded — the actual automation engine.
model ChecklistTemplateItem {
  id        String       @id @default(cuid())
  stage     ProjectStage
  title     String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([stage])
}

// A checklist item generated (or manually added) on a specific job. Source
// distinguishes what the automation engine created from what a person added.
model JobChecklistItem {
  id        String       @id @default(cuid())
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  stage     ProjectStage
  title     String
  source    String       @default("MANUAL") // "AUTOMATED" | "MANUAL"
  done      Boolean      @default(false)
  doneAt    DateTime?
  doneBy    Worker?      @relation(fields: [doneById], references: [id])
  doneById  String?
  createdAt DateTime     @default(now())

  @@index([jobId, stage])
}

enum DocumentCategory {
  DRAWING
  CONTRACT
  RFI
  SUBMITTAL
  PHOTO
  SAFETY
  CLOSEOUT
  WARRANTY
  OTHER
}

// Drawings, contracts, RFIs, submittals, field photos, safety docs, closeout
// files, warranties — every job-specific document living against the project
// record instead of scattered across email and shared drives. Stored as
// Postgres blobs for MVP simplicity, same caveat as DailyReportPhoto: fine at
// this scale, a real object store (S3/R2) is the right move before heavy volume.
model Document {
  id           String           @id @default(cuid())
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String
  category     DocumentCategory
  title        String
  data         Bytes
  contentType  String
  fileSize     Int
  uploadedBy   Worker?          @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  createdAt    DateTime         @default(now())

  @@index([jobId, category])
}

// One row per significant mutation — who, what, on which record, when. Not
// every action in the app logs here (that would be most of the codebase);
// it covers the mutations that matter for an audit trail: stage changes,
// approvals, deletions, status changes on money-adjacent records.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  userRole   Role
  action     String
  entityType String
  entityId   String?
  jobId      String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([entityType, entityId])
}

// Hashed API keys for server-to-server access (app/api/v1/*). The plaintext
// key is shown exactly once, at creation, in the UI — never stored or
// retrievable again, same principle as a password.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

enum WebhookEvent {
  JOB_STAGE_CHANGED
  CHANGE_ORDER_APPROVED
  INVOICE_SENT
  DAILY_REPORT_SUBMITTED
}

model Webhook {
  id         String            @id @default(cuid())
  url        String
  events     WebhookEvent[]
  secret     String
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
}

// Delivery attempts recorded for visibility — did the endpoint actually
// receive it, what did it respond with.
model WebhookDelivery {
  id         String       @id @default(cuid())
  webhook    Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId  String
  event      WebhookEvent
  payload    String
  statusCode Int?
  success    Boolean
  createdAt  DateTime     @default(now())

  @@index([webhookId, createdAt])
}
