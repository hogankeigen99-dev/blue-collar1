generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Role {
  ADMIN
  PM
  FOREMAN
}

enum UnitOfMeasure {
  CY // cubic yard
  SF // square foot
  LF // linear foot
  SQ // roofing square
  TON
  EA // each
  HR // hour (labor-only cost codes, e.g. punch list)
  LS // lump sum
}

// Construction-phase stage, distinct from JobStatus (which tracks whether the
// job is scheduled/active/done at all). Drives the Command Center and billing
// readiness — e.g. you can't be billing-ready before CLOSEOUT.
enum ProjectStage {
  PRECON
  MOBILIZATION
  ACTIVE
  PUNCH_LIST
  CLOSEOUT
  COMPLETE
}

enum CostCategory {
  LABOR
  MATERIAL
  EQUIPMENT
  SUBCONTRACTOR
  OTHER
}

enum ChangeOrderStatus {
  IDENTIFIED
  PRICED
  SUBMITTED
  APPROVED
  REJECTED
}

enum MaterialRequestStatus {
  REQUESTED
  APPROVED
  PO_ISSUED
  ORDERED
  RECEIVED
  REJECTED
}

enum EquipmentOwnership {
  OWNED
  RENTED
}

enum SubcontractorCostStatus {
  COMMITTED
  INVOICED
  PAID
}

enum SubcontractAgreementStatus {
  DRAFT
  EXECUTED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

// --- Multi-tenancy ---
//
// Company is the hard security boundary: every "root" model below (one a
// page/route can look up directly by its own id) carries a companyId and is
// scoped by it on every query, enforced centrally by the Prisma Client
// Extension in lib/tenant.ts rather than trusted to each call site. Child
// records (a JobCostCode, a DailyReportPhoto, ...) are NOT separately
// company-scoped — they inherit isolation from their parent (a JobCostCode
// is only ever reached through an already-scoped Job), which is why any
// code path that looks up a child by its own id directly (the photo/document
// download routes) must explicitly re-validate the parent chain instead of
// relying on the extension.
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  divisions              Division[]
  users                  User[]
  workers                Worker[]
  customers              Customer[]
  jobs                   Job[]
  costCodes              CostCode[]
  equipment              Equipment[]
  apiKeys                ApiKey[]
  webhooks               Webhook[]
  accountingMappings     AccountingCategoryMapping[]
  checklistTemplateItems ChecklistTemplateItem[]
  auditLogs              AuditLog[]
  ssoConfig              SsoConfig?
  integrationCredentials IntegrationCredential[]
  opportunities          Opportunity[]
  vendors                Vendor[]
}

// Organizational segmentation within a company (e.g. "Concrete Division",
// "Northeast Region") — not itself a security boundary the way Company is,
// just a way to group jobs and staff.
model Division {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  name      String
  createdAt DateTime @default(now())

  users Worker[] @relation("WorkerDivision")
  jobs  Job[]

  @@unique([companyId, name])
}

model Worker {
  id                  String                 @id @default(cuid())
  company             Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId           String
  division            Division?              @relation("WorkerDivision", fields: [divisionId], references: [id])
  divisionId          String?
  // Links this crew member to their own login account, when they have one —
  // User (an account someone signs in with) and Worker (a schedulable crew
  // member, who may never log in at all) are deliberately separate today;
  // this is the one connector between them, letting a signed-in FOREMAN's
  // "today" home be personalized to their actual assignment instead of a
  // generic company-wide list. Nullable: a Worker with no account, or a User
  // (e.g. an office PM) with no Worker record, are both normal.
  user                User?                  @relation(fields: [userId], references: [id])
  userId              String?                @unique
  name                String
  role                String?
  phone               String?
  email               String?
  laborRate           Float? // $/hr — used to price actual labor cost from logged production hours
  active              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  jobs                JobAssignment[]
  productionEntries   ProductionEntry[]
  scheduleAssignments ScheduleAssignment[]
  dailyReports        DailyReport[]
  materialRequests    MaterialRequest[]
  changeOrdersCreated ChangeOrder[]
  foremanForJobs      Job[]                  @relation("JobForeman")
  unavailability      WorkerUnavailability[]
  checklistItemsDone  JobChecklistItem[]
  documentsUploaded   Document[]
  benchmarksAsForeman CostCodeBenchmark[]    @relation("CostCodeBenchmarkForeman")

  @@index([companyId])
}

// A day a worker is marked unavailable (PTO, sick, other commitment) — checked
// when assigning the crew schedule so a dispatcher gets a warning instead of
// silently double-booking someone who can't actually show up.
model WorkerUnavailability {
  id        String   @id @default(cuid())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([workerId, date])
}

// Login account. Distinct from Worker (a Worker is a crew member who may or
// may not ever log in — a laborer with no account is still schedulable and
// can still be recorded as who a foreman entered production for).
model User {
  id                    String        @id @default(cuid())
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId             String
  name                  String
  email                 String        @unique
  passwordHash          String? // null when authProvider is SSO-only
  role                  Role          @default(FOREMAN)
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  pmForJobs             Job[]         @relation("JobPM")
  worker                Worker?
  opportunitiesAssigned Opportunity[] @relation("OpportunityAssignee")

  // SSO-ready: a user authenticates either by password or by an external
  // IdP's subject claim. authProvider decides which login path validates
  // this account; ssoSubject only means something when it's SSO.
  authProvider String  @default("PASSWORD") // "PASSWORD" | "SSO"
  ssoSubject   String?

  @@unique([companyId, ssoSubject])
  @@index([companyId])
}

// Per-company SSO configuration (OIDC authorization-code flow). Inert until
// enabled+configured with a real identity provider's details — the customer
// registers CrewSync as a client in their own IdP (Okta, Azure AD, Google
// Workspace, ...) and pastes the issuer/client id/secret in here.
model SsoConfig {
  id                    String   @id @default(cuid())
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId             String   @unique
  enabled               Boolean  @default(false)
  issuerUrl             String?
  clientId              String?
  clientSecretEncrypted String? // AES-256-GCM via lib/crypto.ts — never stored in plaintext
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Generic encrypted credential storage for external-system connectors
// (Autodesk, BuildingConnected, an accounting system's API). Not read by any
// live connector yet — see lib/accounting/connector.ts — but the storage is
// real and the encryption is real, so wiring a connector to it later doesn't
// need a security redesign.
enum IntegrationProvider {
  AUTODESK
  BUILDINGCONNECTED
  QUICKBOOKS
  SAGE
  FOUNDATION
}

model IntegrationCredential {
  id            String              @id @default(cuid())
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  provider      IntegrationProvider
  encryptedData String // AES-256-GCM ciphertext of a JSON blob (client id/secret/tokens) via lib/crypto.ts
  connected     Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([companyId, provider])
}

model Customer {
  id            String        @id @default(cuid())
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime      @default(now())
  jobs          Job[]
  opportunities Opportunity[]

  @@index([companyId])
}

// Vendor/subcontractor master record — the real entity a MaterialRequest or
// Subcontract points to instead of a free-text name, so "how much have we
// committed to this vendor across every job" and COI compliance are real
// queries instead of a string-matching exercise. Performance fields
// (committed/actual spend, job count) are computed on read
// (lib/vendors.ts), not stored here — same "compute, don't store" pattern
// as everything else in this app.
model Vendor {
  id               String            @id @default(cuid())
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId        String
  name             String
  trade            String? // e.g. "Electrical", "Ready-mix concrete"
  contactInfo      String?
  createdAt        DateTime          @default(now())
  materialRequests MaterialRequest[]
  subcontracts     Subcontract[]

  @@unique([companyId, name])
  @@index([companyId])
}

// Company-wide win rate over time, and a company's true win rate stays
// visible even for prospects that went nowhere. WON is the only path a
// Job gets created from an Opportunity — see lib/award-actions.ts.
enum OpportunityStage {
  OPPORTUNITY // qualifying — is this worth bidding at all
  BIDDING // actively estimating
  SUBMITTED // bid submitted, awaiting the customer's decision
  WON
  LOST
  NO_BID // declined to bid — distinct from LOST (never competed for it)
}

// The front door: what the company is chasing before it's a real, awarded
// project. Deliberately a separate, lightweight entity rather than an early
// Job stage — a healthy GC loses more bids than it wins, and every lost one
// would otherwise burn a jobNumber and a Command Center for a project that
// never happened. A Job (with a real jobNumber) is only ever created on WON,
// via the same Award flow every other project goes through
// (lib/award-actions.ts prefills from here when ?opportunityId= is present).
model Opportunity {
  id        String  @id @default(cuid())
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  // "{year}-B{seq}" — a separate sequence from jobNumber (lib/opportunity-number.ts)
  // so lost bids never consume or gap a real project number.
  bidNumber String

  title          String
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerId     String?
  // Free text when there's no Customer record yet — most bids don't have
  // one until they're won.
  prospectName   String?
  source         String? // "Referral", "Plan room", "Repeat client", ...
  // Same free-text convention as Job.projectType — lets win-rate reporting
  // and the historical-rate panel filter/match by kind of work.
  projectType    String?
  estimatedValue Float?
  probability    Int? // 0-100, the PM/estimator's own read, not computed
  bidDueDate     DateTime?

  stage      OpportunityStage @default(OPPORTUNITY)
  lostReason String? // only meaningful once stage is LOST

  assignedTo       User?   @relation("OpportunityAssignee", fields: [assignedToUserId], references: [id])
  assignedToUserId String?

  // Set once, on WON — the provenance link back from the Job this became.
  wonJob   Job?    @relation("OpportunityWonJob", fields: [wonJobId], references: [id])
  wonJobId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costCodes OpportunityCostCode[]

  @@unique([companyId, bidNumber])
  @@index([companyId])
}

// The pre-award estimate — deliberately parallel to JobCostCode, not a
// shared table: JobCostCode's shape and every query built on it already
// assumes a real, awarded Job (billing readiness, job costing, benchmark
// recording). This becomes the Job's starting JobCostCode rows the moment
// the Opportunity is marked WON, via the Award form's normal cost-code
// submission (pre-filled, not copied by a second code path).
model OpportunityCostCode {
  id             String      @id @default(cuid())
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId  String
  costCode       CostCode    @relation(fields: [costCodeId], references: [id])
  costCodeId     String
  estimatedQty   Float
  estimatedHours Float

  @@unique([opportunityId, costCodeId])
}

model Job {
  id          String       @id @default(cuid())
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  division    Division?    @relation(fields: [divisionId], references: [id])
  divisionId  String?
  // Provenance: the Opportunity this Job was awarded from, when it came
  // through the pipeline rather than a direct-negotiated/repeat-work Award.
  // The foreign key lives on Opportunity.wonJobId (set once, on WON) — this
  // is just the reverse side of that same relation, not a second FK.
  opportunity Opportunity? @relation("OpportunityWonJob")
  // 1:1 — the real FK lives on Contract.jobId, this is the reverse side.
  contract    Contract?
  // Human-readable project number ("2026-014") — the PM-facing identifier
  // instead of the opaque cuid. Auto-generated at award time
  // (lib/award-actions.ts): current year + next sequence for that
  // company+year, derived from the current max rather than a separate
  // sequence table — fine at this app's actual concurrency (one project
  // awarded at a time), not safe under concurrent creates.
  jobNumber   String
  title       String
  description String?
  status      JobStatus    @default(SCHEDULED)
  address     String?
  scheduledAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  customer    Customer?    @relation(fields: [customerId], references: [id])
  customerId  String?

  // Command Center fields
  contractValue        Float?
  pm                   User?        @relation("JobPM", fields: [pmUserId], references: [id])
  pmUserId             String?
  foreman              Worker?      @relation("JobForeman", fields: [foremanWorkerId], references: [id])
  foremanWorkerId      String?
  targetStartDate      DateTime?
  targetEndDate        DateTime?
  stage                ProjectStage @default(PRECON)
  punchListComplete    Boolean      @default(false)
  requiredDocsComplete Boolean      @default(false)
  // Free-text project classification ("Residential slab", "Commercial TI",
  // "Site work", ...) — lets the estimate/actual history be filtered by the
  // kind of work, distinct from Division (org/business-line grouping).
  projectType          String?

  assignments          JobAssignment[]
  costCodes            JobCostCode[]
  scheduleAssignments  ScheduleAssignment[]
  budgets              JobBudget[]
  changeOrders         ChangeOrder[]
  dailyReports         DailyReport[]
  materialRequests     MaterialRequest[]
  equipmentAssignments EquipmentAssignment[]
  subcontracts         Subcontract[]
  invoices             Invoice[]
  checklistItems       JobChecklistItem[]
  documents            Document[]
  costCodeBenchmarks   CostCodeBenchmark[]

  @@unique([companyId, jobNumber])
  @@index([companyId])
}

// A real invoice record — a pay application. "amount" (what's actually due
// this period) is computed as sum(InvoiceLine.amountThisPeriod) minus
// sum(InvoiceLine.retainageWithheld) rather than a manually-typed total, so
// it can't drift from the SOV lines actually billed — same "compute, don't
// type" upgrade Contract.lines gave contractValue. A job without a Contract
// yet (pre-migration data) can still get a line-less invoice with a typed
// amount — lines is optional, not required.
model Invoice {
  id            String        @id @default(cuid())
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String
  invoiceNumber String
  amount        Float
  date          DateTime
  status        InvoiceStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime      @default(now())
  lines         InvoiceLine[]

  @@unique([jobId, invoiceNumber])
}

enum ContractType {
  LUMP_SUM
  COST_PLUS
  TIME_AND_MATERIALS
  GMP
}

// The owner-facing contract: type, retainage, and the Schedule of Values
// (SOV) — the billing breakdown, deliberately *not* the same list as cost
// codes (a cost code tracks internal cost; an SOV line like "10%
// Mobilization" is billed to the owner and has no cost-code equivalent).
// 1:1 with Job, created automatically at Award (lib/award-actions.ts) so
// every new job has one from day one rather than a second manual setup
// step. The signed document itself lives in the existing Document model
// (category: CONTRACT) — no separate link field needed here.
model Contract {
  id           String         @id @default(cuid())
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String         @unique
  type         ContractType   @default(LUMP_SUM)
  retainagePct Float?
  executedDate DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lines        ContractLine[]
}

// A Schedule of Values line — what the owner is billed for. Most lines are
// entered manually (mobilization, phases of scope, ...); a CO-sourced line
// is created automatically the moment its ChangeOrder is approved
// (lib/change-order-actions.ts), so the SOV total never drifts out of sync
// with approved contract changes, and removed again if the change order is
// later un-approved before anything against it has been billed.
model ContractLine {
  id                  String       @id @default(cuid())
  contract            Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractId          String
  description         String
  scheduledValue      Float
  sortOrder           Int          @default(0)
  sourceChangeOrder   ChangeOrder? @relation(fields: [sourceChangeOrderId], references: [id])
  sourceChangeOrderId String?      @unique
  createdAt           DateTime     @default(now())

  invoiceLines InvoiceLine[]
}

// One pay-application line per invoice per SOV line — the AIA G702/G703
// pattern real progress billing uses: this period's earned amount and
// retainage withheld, tied to a specific ContractLine so "billed to date"
// per SOV line is a real sum instead of a typed total, and a line can't be
// billed past its scheduled value (lib/billing.ts checks this, computed).
model InvoiceLine {
  id                    String       @id @default(cuid())
  invoice               Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId             String
  contractLine          ContractLine @relation(fields: [contractLineId], references: [id])
  contractLineId        String
  pctCompleteThisPeriod Float
  pctCompleteToDate     Float
  amountThisPeriod      Float
  retainageWithheld     Float        @default(0)

  @@unique([invoiceId, contractLineId])
}

model JobAssignment {
  id       String @id @default(cuid())
  job      Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId    String
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId String

  @@unique([jobId, workerId])
}

// Master cost code list — the estimating asset. Historical productivity
// (actual hrs/unit) is derived from ProductionEntry rows across every job
// that has ever used this code, not stored redundantly here.
model CostCode {
  id                   String                @id @default(cuid())
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId            String
  code                 String
  description          String
  unit                 UnitOfMeasure
  glCode               String? // maps this cost code to the accounting system's GL/cost code for export
  createdAt            DateTime              @default(now())
  jobCostCodes         JobCostCode[]
  benchmarks           CostCodeBenchmark[]
  opportunityCostCodes OpportunityCostCode[]

  @@unique([companyId, code])
  @@index([companyId])
}

// Maps each cost category to a GL account for the accounting export — a
// company-wide setting (not per-job), configured once by accounting/admin.
model AccountingCategoryMapping {
  id            String       @id @default(cuid())
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String
  category      CostCategory
  glCode        String
  glAccountName String?
  updatedAt     DateTime     @updatedAt

  @@unique([companyId, category])
}

// The budget line: what a job's estimate says a cost code should cost in
// quantity and labor hours. This is the "connects to your estimate" piece —
// actuals logged against it are compared back to these numbers in real time.
model JobCostCode {
  id             String            @id @default(cuid())
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  costCode       CostCode          @relation(fields: [costCodeId], references: [id])
  costCodeId     String
  estimatedQty   Float
  estimatedHours Float
  createdAt      DateTime          @default(now())
  entries        ProductionEntry[]

  @@unique([jobId, costCodeId])
}

// A closed-loop estimate-vs-actual record, snapshotted once (per job+cost
// code) the moment a job reaches COMPLETE — lib/productivity-benchmarks.ts's
// recordBenchmarksForCompletedJob(), triggered alongside the stage-change
// automation in lib/command-center-actions.ts. Deliberately a separate,
// point-in-time table rather than re-aggregating live ProductionEntry rows
// on every read: an in-progress job's partial, still-moving numbers
// shouldn't dilute the historical rate estimators actually bid from: only
// finished, reconciled cost-code lines count as a benchmark. Re-running
// completion (e.g. a PM re-saving the command-center form) upserts the same
// row rather than duplicating it.
model CostCodeBenchmark {
  id              String   @id @default(cuid())
  costCode        CostCode @relation(fields: [costCodeId], references: [id])
  costCodeId      String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId           String
  projectType     String? // denormalized from Job.projectType at snapshot time, for filtering
  foreman         Worker?  @relation("CostCodeBenchmarkForeman", fields: [foremanWorkerId], references: [id])
  foremanWorkerId String?
  estimatedQty    Float
  estimatedHours  Float
  actualQty       Float
  actualHours     Float
  estimatedRate   Float? // hrs/unit bid
  actualRate      Float? // hrs/unit actually run
  variancePct     Float? // (actualRate - estimatedRate) / estimatedRate
  recordedAt      DateTime @default(now())

  @@unique([jobId, costCodeId])
  @@index([costCodeId])
}

// A single day's field-reported labor and quantity-installed against a
// job's cost code budget line. This is the daily foreman input that closes
// the field-to-cost feedback loop same-day instead of on a payroll cycle.
// Normally created (and, on resubmission, wholesale replaced) alongside a
// DailyReport by lib/daily-report-actions.ts — dailyReportId is nullable
// only so older/seeded entries logged without a report stay valid.
model ProductionEntry {
  id            String       @id @default(cuid())
  jobCostCode   JobCostCode  @relation(fields: [jobCostCodeId], references: [id], onDelete: Cascade)
  jobCostCodeId String
  dailyReport   DailyReport? @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  dailyReportId String?
  date          DateTime
  crewSize      Int?
  hours         Float
  quantity      Float
  notes         String?
  enteredBy     Worker?      @relation(fields: [enteredById], references: [id])
  enteredById   String?
  createdAt     DateTime     @default(now())

  @@index([jobCostCodeId])
  @@index([dailyReportId])
}

// One worker's job assignment for one calendar day — the crew scheduling
// board. A worker can only be on one job per day, which is what keeps a
// GC from double-booking a crew across concurrent jobs.
model ScheduleAssignment {
  id        String   @id @default(cuid())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([workerId, date])
  @@index([jobId, date])
}

// The original budget per cost category, set once at job kickoff. Committed
// and actual dollars are computed from the operational tables below (material
// requests, equipment assignments, subcontractor costs, logged labor hours)
// rather than duplicated here, so they can't drift out of sync.
model JobBudget {
  id              String       @id @default(cuid())
  job             Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId           String
  category        CostCategory
  estimatedAmount Float
  createdAt       DateTime     @default(now())

  @@unique([jobId, category])
}

// Field-identified extra work, priced and routed through PM approval before
// it becomes contract revenue and budget — the change-order workflow.
model ChangeOrder {
  id                  String            @id @default(cuid())
  job                 Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId               String
  title               String
  description         String?
  status              ChangeOrderStatus @default(IDENTIFIED)
  revenueAmount       Float? // added to contract value once approved
  costAmount          Float? // added budget impact once approved
  sourceDailyReport   DailyReport?      @relation(fields: [sourceDailyReportId], references: [id])
  sourceDailyReportId String?
  createdBy           Worker?           @relation(fields: [createdById], references: [id])
  createdById         String?
  createdAt           DateTime          @default(now())
  approvedAt          DateTime?
  // 1:1 — the real FK lives on ContractLine.sourceChangeOrderId, this is
  // the reverse side (set only while APPROVED and its revenue is billable).
  contractLine        ContractLine?
}

// The upgraded field daily report — one per job per day, fast to fill out,
// covering crew/hours, progress, and every exception category (material,
// equipment, safety, change conditions, delays) in one form.
model DailyReport {
  id                   String   @id @default(cuid())
  job                  Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId                String
  date                 DateTime
  crewSize             Int?
  hours                Float?
  quantityInstalled    String? // free-text — e.g. "35 CY slab", not tied to a specific cost code
  workCompleted        String?
  blockers             String?
  materialNeeded       String?
  equipmentIssue       String?
  safetyIssue          String?
  hasChangeCondition   Boolean  @default(false)
  changeConditionNotes String?
  delayReason          String?
  tomorrowPlan         String?
  submittedBy          Worker?  @relation(fields: [submittedById], references: [id])
  submittedById        String?
  createdAt            DateTime @default(now())

  photos            DailyReportPhoto[]
  changeOrders      ChangeOrder[]
  productionEntries ProductionEntry[]
  materialRequests  MaterialRequest[]

  @@unique([jobId, date])
  @@index([jobId, date])
}

// Small photo blobs stored in Postgres for MVP simplicity — fine at this
// scale, but a real object store (S3/R2) is the right move before this sees
// heavy photo volume.
model DailyReportPhoto {
  id            String      @id @default(cuid())
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  dailyReportId String
  data          Bytes
  contentType   String
  createdAt     DateTime    @default(now())

  @@index([dailyReportId])
}

// Field request → PM approval → vendor/PO → ordered → received → job cost.
// A request stuck short of RECEIVED past its expected delivery date is what
// the material-risk alert watches for. Most requests originate automatically
// from a daily report's "material needed" note (lib/daily-report-actions.ts)
// rather than a separate PM-typed entry — sourceDailyReportId links back to
// that origin; it's left null (not cascade-deleted) if the report is ever
// removed, since the request may already carry a real vendor/PO commitment.
model MaterialRequest {
  id                   String                @id @default(cuid())
  job                  Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId                String
  description          String
  quantity             Float
  unit                 String
  status               MaterialRequestStatus @default(REQUESTED)
  vendor               Vendor?               @relation(fields: [vendorId], references: [id])
  vendorId             String?
  poNumber             String?
  unitCost             Float?
  totalCost            Float?
  expectedDeliveryDate DateTime?
  receivedDate         DateTime?
  sourceDailyReport    DailyReport?          @relation(fields: [sourceDailyReportId], references: [id])
  sourceDailyReportId  String?
  requestedBy          Worker?               @relation(fields: [requestedById], references: [id])
  requestedById        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// Owned or rented equipment, assignable to jobs with a planned date range —
// the source of both scheduling conflicts (same unit, overlapping jobs) and
// actual equipment cost against budget.
model Equipment {
  id              String                @id @default(cuid())
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  name            String
  type            String?
  ownership       EquipmentOwnership    @default(OWNED)
  dailyRentalCost Float?
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  assignments     EquipmentAssignment[]

  @@index([companyId])
}

model EquipmentAssignment {
  id               String    @id @default(cuid())
  equipment        Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  equipmentId      String
  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId            String
  startDate        DateTime
  endDate          DateTime
  actualPickupDate DateTime?
  actualReturnDate DateTime?
  downtimeNotes    String?
  createdAt        DateTime  @default(now())

  @@index([equipmentId, startDate, endDate])
  @@index([jobId])
}

// A real subcontract agreement — promoted from a flat committed-vs-actual
// line item. Two independent status tracks, both real and both needed:
// `status` is billing/payment progress (committed only, invoiced, paid);
// `agreementStatus` is the contract's own lifecycle (drafted, signed,
// closed out) — a subcontract can be fully EXECUTED while still only
// COMMITTED (nothing invoiced yet), or CLOSED while still being paid down.
model Subcontract {
  id                String                     @id @default(cuid())
  job               Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId             String
  vendor            Vendor?                    @relation(fields: [vendorId], references: [id])
  vendorId          String?
  description       String?
  committedAmount   Float
  actualAmount      Float                      @default(0)
  status            SubcontractorCostStatus    @default(COMMITTED)
  agreementStatus   SubcontractAgreementStatus @default(DRAFT)
  retainagePct      Float?
  // Certificate-of-insurance compliance — a real construction-specific gap
  // (lib/alerts.ts's COI_EXPIRED check reads this, not decorative).
  coiExpirationDate DateTime?
  executedDate      DateTime?
  createdAt         DateTime                   @default(now())
}

// Company-wide template: what checklist items get auto-generated when a job
// enters a given stage. Editable so the automation stays configurable
// instead of hardcoded — the actual automation engine.
model ChecklistTemplateItem {
  id        String       @id @default(cuid())
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  stage     ProjectStage
  title     String
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([companyId, stage])
}

// A checklist item generated (or manually added) on a specific job. Source
// distinguishes what the automation engine created from what a person added.
model JobChecklistItem {
  id        String       @id @default(cuid())
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  stage     ProjectStage
  title     String
  source    String       @default("MANUAL") // "AUTOMATED" | "MANUAL"
  done      Boolean      @default(false)
  doneAt    DateTime?
  doneBy    Worker?      @relation(fields: [doneById], references: [id])
  doneById  String?
  createdAt DateTime     @default(now())

  @@index([jobId, stage])
}

enum DocumentCategory {
  DRAWING
  CONTRACT
  RFI
  SUBMITTAL
  PHOTO
  SAFETY
  CLOSEOUT
  WARRANTY
  OTHER
}

// Drawings, contracts, RFIs, submittals, field photos, safety docs, closeout
// files, warranties — every job-specific document living against the project
// record instead of scattered across email and shared drives. Stored as
// Postgres blobs for MVP simplicity, same caveat as DailyReportPhoto: fine at
// this scale, a real object store (S3/R2) is the right move before heavy volume.
model Document {
  id           String           @id @default(cuid())
  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        String
  category     DocumentCategory
  title        String
  data         Bytes
  contentType  String
  fileSize     Int
  uploadedBy   Worker?          @relation(fields: [uploadedById], references: [id])
  uploadedById String?
  createdAt    DateTime         @default(now())

  @@index([jobId, category])
}

// One row per significant mutation — who, what, on which record, when.
// Covers stage changes, approvals, deletions, status changes on
// money-adjacent records, and security-config changes (keys, webhooks, GL
// mapping) — see lib/audit.ts for the exact call sites.
model AuditLog {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  userId     String?
  userName   String
  userRole   Role
  action     String
  entityType String
  entityId   String?
  jobId      String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([jobId, createdAt])
  @@index([entityType, entityId])
}

// Hashed API keys for server-to-server access (app/api/v1/*). The plaintext
// key is shown exactly once, at creation, in the UI — never stored or
// retrievable again, same principle as a password.
model ApiKey {
  id         String    @id @default(cuid())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  name       String
  keyHash    String    @unique
  keyPrefix  String
  active     Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([companyId])
}

enum WebhookEvent {
  JOB_STAGE_CHANGED
  CHANGE_ORDER_APPROVED
  INVOICE_SENT
  DAILY_REPORT_SUBMITTED
}

model Webhook {
  id         String            @id @default(cuid())
  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  url        String
  events     WebhookEvent[]
  secret     String
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  @@index([companyId])
}

// Delivery attempts recorded for visibility — did the endpoint actually
// receive it, what did it respond with. Failed deliveries are retried with
// exponential backoff (nextRetryAt) up to a cap, then deadLettered so a
// permanently-broken endpoint doesn't retry forever.
model WebhookDelivery {
  id           String       @id @default(cuid())
  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  webhookId    String
  event        WebhookEvent
  payload      String
  statusCode   Int?
  success      Boolean
  attempt      Int          @default(1)
  nextRetryAt  DateTime?
  deadLettered Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([webhookId, createdAt])
  @@index([nextRetryAt])
}
