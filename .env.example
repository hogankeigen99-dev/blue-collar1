DATABASE_URL="postgresql://user:password@localhost:5432/blue_collar"

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# Do NOT reuse the same value across environments, and never commit a real one.
AUTH_SECRET="replace-with-a-long-random-string"

# 256-bit key (base64) used to encrypt SSO client secrets and integration
# credentials at rest (lib/crypto.ts). Generate one with:
#   openssl rand -base64 32
# Do NOT reuse the same value across environments, and never commit a real one.
# Rotating this key makes every previously-encrypted secret unreadable —
# re-save each one (SSO config, integration credentials) after rotating.
CREDENTIALS_ENCRYPTION_KEY="replace-with-a-base64-256-bit-key"

# Shared secret your scheduler (Railway cron, GitHub Actions, etc.) sends as
# "Authorization: Bearer <this>" to trigger webhook retry processing at
# /api/cron/webhook-retries (lib/webhook-retry.ts). Generate one with:
#   openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# App-level Sage Intacct OAuth app registration (lib/accounting/sage-oauth.ts)
# — register once at developer.sage.com/intacct, identifies CrewSync itself,
# not any one customer. Each company then connects its own Sage Intacct
# company from Settings → Integrations.
SAGE_INTACCT_CLIENT_ID=""
SAGE_INTACCT_CLIENT_SECRET=""

# Anthropic API key for the AI features (lib/ai/) — summarizing field
# reports, drafting change orders, and the job Q&A panel. Get one from
# console.anthropic.com; this is billed to your own account and is separate
# from any Claude Code login. Every AI panel in the app stays hidden until
# this is set — nothing fakes a response when it's missing.
ANTHROPIC_API_KEY=""
