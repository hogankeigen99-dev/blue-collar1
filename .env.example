DATABASE_URL="postgresql://user:password@localhost:5432/blue_collar"

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# Do NOT reuse the same value across environments, and never commit a real one.
AUTH_SECRET="replace-with-a-long-random-string"

# 256-bit key (base64) used to encrypt SSO client secrets and integration
# credentials at rest (lib/crypto.ts). Generate one with:
#   openssl rand -base64 32
# Do NOT reuse the same value across environments, and never commit a real one.
# Rotating this key makes every previously-encrypted secret unreadable —
# re-save each one (SSO config, integration credentials) after rotating.
CREDENTIALS_ENCRYPTION_KEY="replace-with-a-base64-256-bit-key"
